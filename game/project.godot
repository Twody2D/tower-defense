[internationalization]

locale/translations=PackedStringArray("res://localization/translations.ru.translation", "res://localization/translations.en.translation")
locale/fallback="ru"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=false
environment/defaults/default_clear_color=Color(0.298, 0.686, 0.314, 1)
